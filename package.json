{
  "name": "obsidian-html-single-file-viewer",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "description": "Obsidian 单文件 HTML 视图插件 + 配套单文件 HTML 模板（工程根）",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build-templates.mjs",
    "build:plugin": "npm --prefix plugin run build",
    "build:all": "npm run build && npm run build:plugin",
    "build:release": "npm run build:all && node scripts/stage-release.mjs"
  },
  "devDependencies": {
    "jsdom": "^25.0.1"
  }
}
