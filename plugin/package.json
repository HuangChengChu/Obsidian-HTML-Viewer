{
  "name": "obsidian-html-single-file-view",
  "version": "1.4.0",
  "description": "以自定义视图打开单文件 HTML（内嵌资源），把答题、批注、笔记、手写涂鸦与阅读进度回写进 HTML 文件自身；MD 阅读视图同样支持，数据写进 frontmatter。靠 Obsidian 同步实现跨设备接力。",
  "main": "main.js",
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test ../tests/"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.24.2",
    "obsidian": "^1.7.2",
    "typescript": "^5.7.2"
  }
}
